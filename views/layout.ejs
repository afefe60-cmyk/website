<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRTL ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= t.siteName %> — Haute Parfumerie & Luxury Essence. <%= t.footerTagline %>">
    <meta name="keywords" content="AJMAN LUXURY, luxury perfumes, oud, extrait de parfum, UAE perfume, عجمان لكجري, عطور">
    <title><%= t.siteName %> | Haute Parfumerie</title>
    
    <link rel="icon" href="<%= designSettings.faviconPath || '/favicon.png' %>">
    <link rel="shortcut icon" href="<%= designSettings.faviconPath || '/favicon.png' %>">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    
    <!-- FontAwesome Icons & Stylesheet -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        :root {
            --ink: <%- designSettings.ink || '#16110f' %>;
            --gold: <%- designSettings.gold || '#c8a45d' %>;
            --paper: <%- designSettings.paper || '#fffaf3' %>;
            --mist: <%- designSettings.mist || '#f6ece4' %>;
            --card-radius: <%- designSettings.cardRadius || '8px' %>;
            --hero-logo-opacity: <%- designSettings.heroOpacity || '0.18' %>;
            --site-font: <%- designSettings.fontFamily || '"Adobe Arabic Regular", "Segoe UI", sans-serif' %>;
        }
    </style>
</head>
<body class="theme-<%= designSettings.themeMode || 'royal' %>">

    <!-- Luxury Splash Screen Loader with Perfume Mist Spray Motion -->
    <div id="splash-screen" class="splash-screen">
        <!-- Perfume Spray Mist Particles & Rays -->
        <div class="perfume-mist-container">
            <div class="mist-sparkle sp-1"></div>
            <div class="mist-sparkle sp-2"></div>
            <div class="mist-sparkle sp-3"></div>
            <div class="mist-sparkle sp-4"></div>
            <div class="mist-sparkle sp-5"></div>
            <div class="mist-sparkle sp-6"></div>
        </div>

        <div class="splash-content">
            <div class="bottle-spray-wrapper">
                <!-- Golden Spray Nozzle & Mist Burst Cone -->
                <div class="spray-nozzle-pulse"></div>
                <div class="spray-burst-cone"></div>
                <div class="splash-logo-wrapper perfume-bottle-motion">
                    <img src="/images/logo-wordmark.png" alt="<%= t.siteName %>" class="splash-logo" onerror="this.onerror=null; this.src='/images/logo.png';" />
                </div>
            </div>
            <div class="splash-title font-title gold-shimmer"><%= t.siteName %></div>
            <div class="splash-subtitle"><%= lang === 'ar' ? 'نفحات الإكستري الفاخرة — HAUTE PARFUMERIE' : 'HAUTE PARFUMERIE & LUXURY ESSENCE' %></div>
            <div class="splash-line-wrapper">
                <div class="splash-line wave-fill"></div>
            </div>
        </div>
    </div>

    <!-- Dynamic Luxury Floating Particles Canvas -->
    <canvas id="particles-canvas"></canvas>

    <!-- Top Announcement Bar -->
    <div class="top-bar">
        <div class="container">
            ✨ <%= lang === 'ar' ? 'شحن مجاني فاخر لجميع دول الخليج عند الطلب بأكثر من 500 د.إ | عينات مجانية مع كل طلب' : '✨ Complimentary Luxury Shipping across GCC for orders over AED 500 | Free Discovery Samples' %>
        </div>
    </div>

    <!-- Header / Navigation -->
    <header class="navbar" id="site-navbar">
        <div class="container">
            <!-- Brand Logo in Perfume Bottle Frame -->
            <a href="/?lang=<%= lang %>" class="brand-logo-container" aria-label="<%= t.siteName %>">
                <div class="perfume-bottle-badge">
                    <div class="bottle-nozzle-cap"></div>
                    <div class="bottle-neck-ring"></div>
                    <div class="bottle-body-frame">
                        <img src="/images/logo-wordmark.png" alt="<%= t.siteName %>" class="brand-logo" onerror="this.onerror=null; this.src='/images/logo.png';" />
                    </div>
                </div>
            </a>

            <!-- Nav Links -->
            <ul class="nav-links">
                <li><a href="#home"><%= t.home %></a></li>
                <li><a href="#collection"><%= lang === 'ar' ? 'المجموعة العطرية' : 'Collection' %></a></li>
                <li><a href="#video-showcase"><%= lang === 'ar' ? 'التناغم العطري' : 'Symphony' %></a></li>
                <li><a href="#pyramid"><%= lang === 'ar' ? 'نوتات العطر' : 'Fragrance Pyramid' %></a></li>
                <li><a href="#quiz"><%= t.scentFinder %></a></li>
                <li><a href="#boutiques"><%= t.contact %></a></li>
            </ul>

            <!-- Nav Actions -->
            <div class="nav-actions">
                <!-- Currency Selector -->
                <select id="currency-select" class="currency-select" aria-label="Currency">
                    <option value="AED" selected>AED (د.إ)</option>
                    <option value="USD">USD ($)</option>
                    <option value="SAR">SAR (ر.س)</option>
                </select>

                <!-- Language Switcher Button -->
                <a href="<%= currentPath %>?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" class="lang-switch">
                    <%= lang === 'ar' ? 'English | EN' : 'العربية | AR' %>
                </a>

                <!-- Cart Button -->
                <button class="icon-btn" id="cart-toggle-btn" aria-label="Cart">
                    <svg class="lux-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <span class="cart-badge" id="cart-badge" data-cart-count>0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main View Content -->
    <main id="main-content">
        <%- body %>
    </main>

    <!-- Shopping Cart Drawer -->
    <div class="cart-drawer-overlay" id="cart-overlay">
        <div class="cart-drawer">
            <div class="cart-header">
                <h3 class="cart-title font-title"><%= lang === 'ar' ? 'سلة التسوق الفاخرة' : 'Luxury Shopping Bag' %></h3>
                <button class="close-drawer" id="close-cart-btn" aria-label="Close">
                    <svg class="lux-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="cart-items" id="cart-items">
                <!-- Rendered dynamically by main.js -->
            </div>

            <div class="cart-footer">
                <div class="cart-total-row">
                    <span><%= lang === 'ar' ? 'المجموع الفرعي:' : 'Subtotal:' %></span>
                    <span id="cart-subtotal" class="gold-text">0 د.إ</span>
                </div>
                <a href="/checkout?lang=<%= lang %>" class="btn btn-primary" id="checkout-btn" style="width: 100%; text-align: center; justify-content: center;">
                    <svg class="lux-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg> 
                    <span><%= lang === 'ar' ? 'إتمام الطلب الفاخر' : 'Proceed to Checkout' %></span>
                </a>
            </div>
        </div>
    </div>

    <!-- Quick View Modal -->
    <div class="modal-overlay" id="quick-view-modal">
        <div class="modal-card">
            <button class="close-modal" id="close-modal-btn"><i class="fas fa-times"></i></button>
            <div id="modal-content"></div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- WhatsApp Widget -->
    <div class="whatsapp-widget" data-whatsapp-widget data-lang="<%= lang %>">
        <section class="whatsapp-panel" data-whatsapp-panel hidden aria-label="<%= lang === 'ar' ? 'دردشة خدمة العملاء' : 'Customer care chat' %>">
            <div class="whatsapp-panel-header">
                <div>
                    <strong><%= lang === 'ar' ? 'عجمان لكجري' : 'AJMAN LUXURY' %></strong>
                    <span><%= lang === 'ar' ? 'خدمة العملاء عبر واتساب' : 'WhatsApp customer care' %></span>
                </div>
                <button type="button" data-whatsapp-close aria-label="<%= lang === 'ar' ? 'إغلاق' : 'Close' %>">×</button>
            </div>
            <div class="whatsapp-panel-body" data-whatsapp-messages>
                <div class="chat-bubble support">
                    <%= lang === 'ar' ? 'مرحباً بك 👋 كيف يمكننا مساعدتك في اختيار العطر أو إتمام الطلب؟' : 'Hello 👋 How can we help you choose a perfume or complete your order?' %>
                </div>
            </div>
            <form class="whatsapp-form" data-whatsapp-form>
                <strong class="live-chat-title"><%= lang === 'ar' ? 'لايف شات داخلي' : 'Internal Live Chat' %></strong>
                <input name="name" placeholder="<%= lang === 'ar' ? 'اسمك' : 'Your name' %>">
                <input name="phone" placeholder="<%= lang === 'ar' ? 'رقم الهاتف' : 'Phone number' %>">
                <textarea name="message" rows="3" required placeholder="<%= lang === 'ar' ? 'اكتب استفسارك هنا...' : 'Write your question here...' %>"></textarea>
                <button type="submit"><%= lang === 'ar' ? 'إرسال' : 'Send' %></button>
                <small data-whatsapp-status></small>
            </form>
        </section>
        <div class="chat-launchers">
            <a class="whatsapp-chat whatsapp-external-chat" href="<%= whatsappUrl %>" target="_blank" rel="noopener" aria-label="<%= lang === 'ar' ? 'فتح واتساب خارجي' : 'Open external WhatsApp chat' %>">
                <span class="whatsapp-icon" aria-hidden="true">
                    <svg class="whatsapp-logo" viewBox="0 0 32 32">
                        <path d="M16.01 3.2c-7.03 0-12.75 5.62-12.75 12.54 0 2.21.59 4.37 1.71 6.27L3.15 28.8l6.99-1.78a12.91 12.91 0 0 0 5.87 1.43c7.03 0 12.75-5.62 12.75-12.54S23.04 3.2 16.01 3.2Zm0 23.1c-1.84 0-3.65-.47-5.24-1.36l-.38-.21-4.15 1.06 1.1-4.01-.25-.41a10.33 10.33 0 0 1-1.61-5.63c0-5.73 4.72-10.4 10.53-10.4s10.53 4.67 10.53 10.4-4.72 10.56-10.53 10.56Zm5.78-7.77c-.32-.16-1.88-.92-2.17-1.02-.29-.11-.5-.16-.71.16-.21.31-.82 1.02-1 1.23-.18.21-.37.24-.69.08-.32-.16-1.34-.49-2.55-1.56-.94-.83-1.58-1.86-1.77-2.17-.18-.31-.02-.48.14-.64.14-.14.32-.37.47-.55.16-.18.21-.31.32-.52.11-.21.05-.39-.03-.55-.08-.16-.71-1.69-.97-2.31-.26-.61-.52-.52-.71-.53h-.6c-.21 0-.55.08-.84.39-.29.31-1.1 1.07-1.1 2.6s1.13 3.02 1.29 3.23c.16.21 2.22 3.35 5.38 4.69.75.32 1.34.51 1.8.65.76.24 1.45.21 1.99.13.61-.09 1.88-.76 2.15-1.49.26-.73.26-1.36.18-1.49-.08-.13-.29-.21-.61-.37Z"/>
                    </svg>
                </span>
                <span class="whatsapp-copy">
                    <strong><%= lang === 'ar' ? 'واتساب' : 'WhatsApp' %></strong>
                    <small><%= lang === 'ar' ? 'دردشة خارجية' : 'External chat' %></small>
                </span>
            </a>
            <button class="whatsapp-chat live-chat-launcher" type="button" data-whatsapp-toggle aria-label="<%= lang === 'ar' ? 'فتح لايف شات داخلي' : 'Open internal live chat' %>">
                <span class="whatsapp-icon">💬</span>
                <span class="whatsapp-copy">
                    <strong><%= lang === 'ar' ? 'لايف شات' : 'Live Chat' %></strong>
                    <small><%= lang === 'ar' ? 'داخل الموقع' : 'Inside site' %></small>
                </span>
            </button>
        </div>
    </div>

    <!-- Footer Section -->
    <footer class="footer" id="boutiques">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="/?lang=<%= lang %>" class="brand-logo-container">
                        <div class="perfume-bottle-badge">
                            <div class="bottle-nozzle-cap"></div>
                            <div class="bottle-neck-ring"></div>
                            <div class="bottle-body-frame">
                                <img src="/images/logo-wordmark.png" alt="<%= t.siteName %> Logo" class="brand-logo" onerror="this.onerror=null; this.src='/images/logo.png';" />
                            </div>
                        </div>
                    </a>
                    <p><%= lang === 'ar' ? 'عجمان لكجري — دار عطور إكستريت فاخرة تترجم النوتات العربية والشرقية إلى ذكريات تخلّد الحضور.' : 'AJMAN LUXURY — Extrait de Parfum house translating Arabian notes into unforgettable scents.' %></p>
                </div>

                <div>
                    <h4 class="footer-heading font-title"><%= lang === 'ar' ? 'معارضنا ومقراتنا' : 'Boutiques & Presence' %></h4>
                    <ul class="footer-links">
                        <li><i class="fas fa-map-marker-alt gold-icon"></i> <%= lang === 'ar' ? 'عجمان — شارع النخيل الفاخر، الإمارات' : 'Ajman — Al Nakheel St, UAE' %></li>
                        <li><i class="fas fa-map-marker-alt gold-icon"></i> <%= lang === 'ar' ? 'دبي — فاشن أفينيو، دبي مول' : 'Dubai — Fashion Avenue, Dubai Mall' %></li>
                        <li><i class="fas fa-map-marker-alt gold-icon"></i> <%= lang === 'ar' ? 'الرياض — طريق العليا الفاخر' : 'Riyadh — Olaya Luxury District' %></li>
                    </ul>
                </div>

                <div>
                    <h4 class="footer-heading font-title"><%= lang === 'ar' ? 'روابط سريعة' : 'Quick Links' %></h4>
                    <ul class="footer-links">
                        <li><a href="#collection"><%= lang === 'ar' ? 'المجموعة العطرية' : 'Collection' %></a></li>
                        <li><a href="#pyramid"><%= lang === 'ar' ? 'نوتات العطر' : 'Fragrance Pyramid' %></a></li>
                        <li><a href="#quiz"><%= t.scentFinder %></a></li>
                        <li><a href="#story"><%= t.learnMore %></a></li>
                        <li><a href="/admin/login"><%= lang === 'ar' ? 'لوحة التحكم' : 'Admin Area' %></a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="footer-heading font-title"><%= lang === 'ar' ? 'وسائل الدفع والضمان' : 'Payment & Security' %></h4>
                    <div class="payment-icons">
                        <i class="fab fa-cc-visa fa-2x"></i>
                        <i class="fab fa-cc-mastercard fa-2x"></i>
                        <i class="fab fa-apple-pay fa-2x"></i>
                        <i class="fas fa-shield-alt fa-2x"></i>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <span><%= lang === 'ar' ? 'جميع الحقوق محفوظة © 2026 عجمان لكجري (AJMAN LUXURY).' : 'All Rights Reserved © 2026 AJMAN LUXURY.' %></span>
                <div>Haute Parfumerie & Luxury Essence</div>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
